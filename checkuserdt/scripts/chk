#!/usr/bin/env bash
set -euo pipefail

SERVICE_NAME="checkuser555.service"
APP_DIR="/root/checkuserdt"
SERVICE_PATH="/etc/systemd/system/${SERVICE_NAME}"
PORT="2052"
APP_URL="http://vps.lubunet.shop:2052"

if [[ -f "${SERVICE_PATH}" ]]; then
  port_found="$(grep -oE -- '--port [0-9]+' "${SERVICE_PATH}" | awk '{print $2}' | head -n 1 || true)"
  [[ -n "${port_found}" ]] && PORT="${port_found}"
  app_found="$(grep -oE '^Environment=APP_URL=.*' "${SERVICE_PATH}" | sed 's/^Environment=APP_URL=//' | head -n 1 || true)"
  [[ -n "${app_found}" ]] && APP_URL="${app_found}"
fi

BASE="http://127.0.0.1:${PORT}"
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'

pause(){ echo; read -rp "Pressione ENTER para voltar..." _; }
line(){ echo -e "${CYAN}------------------------------------------------------------${NC}"; }
header(){
  clear 2>/dev/null || true
  echo -e "${BLUE}============================================================${NC}"
  echo -e "${GREEN}              CHECKUSERDT - PAINEL TERMINAL${NC}"
  echo -e "${BLUE}============================================================${NC}"
  echo "Servico: ${SERVICE_NAME}"
  echo "Link do app: ${APP_URL}"
  echo
}

status_service(){
  systemctl status "${SERVICE_NAME}" -l --no-pager || true
}

start_service(){
  sudo systemctl start "${SERVICE_NAME}"
  echo -e "${GREEN}Servico iniciado.${NC}"
}

stop_service(){
  sudo systemctl stop "${SERVICE_NAME}"
  echo -e "${YELLOW}Servico parado.${NC}"
}

restart_service(){
  sudo systemctl restart "${SERVICE_NAME}"
  echo -e "${GREEN}Servico reiniciado.${NC}"
}

test_service(){
  read -rp "Digite o usuario normal ou UUID para testar: " value
  [[ -z "${value}" ]] && { echo -e "${RED}Valor vazio.${NC}"; return; }
  echo
  echo -e "${YELLOW}Resultado:${NC}"
  curl -sS "${BASE}/check/${value}" || true
  echo
}

show_app_link(){
  line
  echo -e "${GREEN}Use este link no app:${NC}"
  echo "${APP_URL}"
  line
}

list_xray_users(){
  echo -e "${YELLOW}Usuarios/UUIDs encontrados no Xray:${NC}"
  curl -sS "${BASE}/users" || true
  echo
}

remove_script(){
  echo -e "${RED}Isso vai remover o servico, binarios e arquivos do CheckUserDT.${NC}"
  read -rp "Digite REMOVER para confirmar: " confirm
  [[ "${confirm}" == "REMOVER" ]] || { echo "Cancelado."; return; }
  sudo bash "${APP_DIR}/uninstall.sh"
}

while true; do
  header
  echo "1) Ver status"
  echo "2) Iniciar"
  echo "3) Parar"
  echo "4) Reiniciar"
  echo "5) Testar usuario ou UUID"
  echo "6) Ver usuarios/UUIDs do Xray"
  echo "7) Mostrar link do app"
  echo "8) Ver logs"
  echo "9) Remover script/servico"
  echo "0) Sair"
  echo
  read -rp "Escolha uma opcao: " opt
  echo
  case "${opt}" in
    1) status_service; pause ;;
    2) start_service; pause ;;
    3) stop_service; pause ;;
    4) restart_service; pause ;;
    5) test_service; pause ;;
    6) list_xray_users; pause ;;
    7) show_app_link; pause ;;
    8) echo "Ctrl+C para sair dos logs."; sleep 1; sudo journalctl -u "${SERVICE_NAME}" -f ;;
    9) remove_script; exit 0 ;;
    0) exit 0 ;;
    *) echo -e "${RED}Opcao invalida.${NC}"; pause ;;
  esac
done
