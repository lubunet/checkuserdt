#!/usr/bin/env bash
set -euo pipefail

SERVICE_NAME="checkuser555.service"
APP_DIR="/root/checkuserdt"
SERVICE_PATH="/etc/systemd/system/${SERVICE_NAME}"
PORT="555"
APP_URL="http://IP_DA_VPS:555"

if [[ -f "${APP_DIR}/app_url" ]]; then
  APP_URL="$(cat "${APP_DIR}/app_url" | head -n 1)"
fi
if [[ -f "${SERVICE_PATH}" ]]; then
  port_found="$(grep -oE -- '--port [0-9]+' "${SERVICE_PATH}" | awk '{print $2}' | head -n 1 || true)"
  [[ -n "${port_found}" ]] && PORT="${port_found}"
  app_found="$(grep -oE '^Environment=APP_URL=.*' "${SERVICE_PATH}" | sed 's/^Environment=APP_URL=//' | head -n 1 || true)"
  [[ -n "${app_found}" ]] && APP_URL="${app_found}"
fi

BASE="http://127.0.0.1:${PORT}"
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'
RED=$'\033[38;5;203m'
GREEN=$'\033[38;5;82m'
YELLOW=$'\033[38;5;221m'
BLUE=$'\033[38;5;39m'
CYAN=$'\033[38;5;51m'
MAGENTA=$'\033[38;5;213m'

pause(){ printf "\n%bPressione ENTER para voltar...%b" "${DIM}" "${RESET}"; read -r _; }
line(){ printf "%b\n" "${CYAN}────────────────────────────────────────────────────────${RESET}"; }

header(){
  clear 2>/dev/null || true
  printf "%b\n" "${MAGENTA}${BOLD}╔════════════════════════════════════════════════════╗${RESET}"
  printf "%b\n" "${MAGENTA}${BOLD}║              CHECKUSERDT  LUBUNET                 ║${RESET}"
  printf "%b\n" "${MAGENTA}${BOLD}╚════════════════════════════════════════════════════╝${RESET}"
  printf "%bServiço:%b %s\n" "${BOLD}" "${RESET}" "${SERVICE_NAME}"
  printf "%bPorta:%b %s\n" "${BOLD}" "${RESET}" "${PORT}"
  printf "%bLink do app:%b %s\n\n" "${BOLD}" "${RESET}" "${APP_URL}"
}

status_service(){
  systemctl status "${SERVICE_NAME}" -l --no-pager || true
}

start_service(){
  sudo systemctl start "${SERVICE_NAME}"
  printf "%bServiço iniciado.%b\n" "${GREEN}${BOLD}" "${RESET}"
}

stop_service(){
  sudo systemctl stop "${SERVICE_NAME}"
  printf "%bServiço parado.%b\n" "${YELLOW}${BOLD}" "${RESET}"
}

restart_service(){
  sudo systemctl restart "${SERVICE_NAME}"
  printf "%bServiço reiniciado.%b\n" "${GREEN}${BOLD}" "${RESET}"
}

test_service(){
  printf "Digite o usuário normal ou UUID para testar: "
  read -r value
  [[ -z "${value}" ]] && { printf "%bValor vazio.%b\n" "${RED}" "${RESET}"; return; }
  printf "\n%bResultado:%b\n" "${YELLOW}${BOLD}" "${RESET}"
  curl -sS "${BASE}/check/${value}" || true
  printf "\n"
}

show_app_link(){
  line
  printf "%bUse este link no app:%b\n%s\n" "${GREEN}${BOLD}" "${RESET}" "${APP_URL}"
  line
}

list_xray_users(){
  printf "%bUsuários/UUIDs encontrados no Xray:%b\n" "${YELLOW}${BOLD}" "${RESET}"
  curl -sS "${BASE}/users" || true
  printf "\n"
}

remove_script(){
  printf "%bIsso vai remover o serviço, binários e arquivos do CheckUserDT.%b\n" "${RED}${BOLD}" "${RESET}"
  printf "Digite REMOVER para confirmar: "
  read -r confirm
  [[ "${confirm}" == "REMOVER" ]] || { printf "Cancelado.\n"; return; }
  sudo bash "${APP_DIR}/uninstall.sh"
}

while true; do
  header
  printf "1) Ver status\n"
  printf "2) Iniciar serviço\n"
  printf "3) Parar serviço\n"
  printf "4) Reiniciar serviço\n"
  printf "5) Testar usuário ou UUID\n"
  printf "6) Ver usuários/UUIDs do Xray\n"
  printf "7) Mostrar link do app\n"
  printf "8) Ver logs em tempo real\n"
  printf "9) Remover script/serviço\n"
  printf "0) Sair\n\n"
  printf "%bEscolha uma opção:%b " "${BOLD}" "${RESET}"
  read -r opt
  printf "\n"
  case "${opt}" in
    1) status_service; pause ;;
    2) start_service; pause ;;
    3) stop_service; pause ;;
    4) restart_service; pause ;;
    5) test_service; pause ;;
    6) list_xray_users; pause ;;
    7) show_app_link; pause ;;
    8) printf "%bCtrl+C para sair dos logs.%b\n" "${YELLOW}" "${RESET}"; sleep 1; sudo journalctl -u "${SERVICE_NAME}" -f ;;
    9) remove_script; exit 0 ;;
    0) exit 0 ;;
    *) printf "%bOpção inválida.%b\n" "${RED}" "${RESET}"; pause ;;
  esac
done
